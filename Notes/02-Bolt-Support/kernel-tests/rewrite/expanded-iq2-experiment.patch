+@triton.jit
+def _expand_iq2_kernel(
+    q_ptr, sc_ptr, lut_ptr, out_ptr, scale_ptr, total, groups_per_row, B: tl.constexpr
+):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    valid = i < total
+    idx = tl.load(q_ptr + (i // 4) * 2, valid, other=0)
+    aux = tl.load(q_ptr + (i // 4) * 2 + 1, valid, other=0)
+    group = i % 4
+    codes = tl.load(lut_ptr + 2048 + ((idx >> (group * 8)) & 255))
+    signs = (aux >> (group * 7)) & 127
+    parity = signs ^ (signs >> 4)
+    parity ^= parity >> 2
+    parity ^= parity >> 1
+    signs |= (parity & 1) << 7
+    row = (i // groups_per_row).to(tl.int64)
+    col = i % groups_per_row
+    base = out_ptr + row * groups_per_row * 3
+    tl.store(base.to(tl.pointer_type(tl.uint16)) + col, codes, valid)
+    tl.store(base + groups_per_row * 2 + col, signs, valid)
+    d = tl.load(sc_ptr + i // 32, valid, other=0.0).to(tl.float32)
+    rs = d * (0.5 + ((aux >> 28) & 15).to(tl.float32)) * 0.25
+    tl.store(scale_ptr + i // 4, rs, valid & (group == 0))
+
+
+def expand_iq2(
+    qweight: torch.Tensor, scales: torch.Tensor, lut: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Expand to code/sign planes and exact fp32 scales at load time.
+
+    Each row contains uint16 magnitude codes followed by uint8 sign masks.
+    Per-32 scales are stored in fp32, avoiding the rounding incurred by fp16.
+    Storage is 128 rather than 66 bytes per 256 weights.
+    """
+    groups = qweight.shape[-1] * 2
+    out = torch.empty(
+        (*qweight.shape[:-1], groups * 3), dtype=torch.uint8, device=qweight.device
+    )
+    rs = torch.empty(
+        (*scales.shape[:-1], scales.shape[-1] * 8),
+        dtype=torch.float32,
+        device=scales.device,
+    )
+    total = qweight.numel() * 2
+    _expand_iq2_kernel[(triton.cdiv(total, 256),)](
+        qweight.contiguous(), scales.contiguous(), lut, out, rs, total, groups, B=256
+    )
+    return out, rs
