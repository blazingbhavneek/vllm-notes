                    output_str_1,
                    logprobs_1,
                    prompt_logprobs_1,
                ) = outputs_1
    
                # Test prompt logprobs closeness
                if prompt_logprobs_0 is not None and prompt_logprobs_1 is not None:
                    # Both sequences' prompt logprobs lists are not `None`
