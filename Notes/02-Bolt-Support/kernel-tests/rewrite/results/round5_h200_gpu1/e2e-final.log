                enforce_eager=not compiled,
                compilation_config={"cudagraph_capture_sizes": [1, 2, 4]},
            ) as llm:
                assert llm.apply_model(finite_scales) == [9]
                outputs.append(llm.generate_w_logprobs(prompts, params))
